# =============================================================================
# Fontes e caminhos
# =============================================================================

COTACOES_SOURCES_FILE=config/fontes.json
COTACOES_RAW_DIR=data/raw
COTACOES_PDF_TEXT_CACHE_DIR=data/cache/pdf-text
COTACOES_DATABASE_PATH=data/cotacoes.sqlite

# Connection string PostgreSQL copiada da opcao Direct/Session pooler.
# Mantenha a senha somente no .env local.
COTACOES_SUPABASE_DATABASE_URL=

# Quantidade de registros confirmada por lote nas sincronizacoes.
COTACOES_SUPABASE_BATCH_SIZE=5000

# =============================================================================
# Janela historica
# =============================================================================

# Data mais recente permitida na busca. Vazio usa a cotacao mais recente.
# Aceita DD/MM/YYYY ou YYYY-MM-DD.
# Quando preenchida, tem prioridade e desativa o historico incremental.
COTACOES_TARGET_DATE=

# Quantidade de datas anteriores a partir da data limite.
# 0 busca somente a publicacao atual.
# 99 busca a data limite e mais 99 anteriores, totalizando 100 datas.
# infinito busca todo o historico encontrado.
COTACOES_QUOTES_BACK=0

# Quando true e QUOTES_BACK solicita historico, continua antes do raw ativo
# mais antigo. Nao atua com QUOTES_BACK=0 nem com TARGET_DATE preenchida.
COTACOES_INCREMENTAL_HISTORY=true

# =============================================================================
# Requisicoes e retomada
# =============================================================================

# Tempo maximo, em segundos, para cada requisicao.
COTACOES_HTTP_TIMEOUT_SECONDS=30

# Intervalo minimo, em segundos, entre requisicoes. Aumentar reduz a pressao
# sobre as fontes, mas deixa a coleta mais lenta.
COTACOES_REQUEST_DELAY_SECONDS=2.0

# Quantidade de fontes baixadas em paralelo nos fluxos de todas as fontes.
# 1 preserva a execucao sequencial. Use 2 ou 3 para reduzir espera de rede.
COTACOES_WORKERS=1

# Quando true, reutiliza um raw ativo caso a mesma fonte, categoria e data
# sejam solicitadas novamente. Util para retomar ou repetir coletas.
# Nao define quais datas serao buscadas e nao consulta `old/` ou arquivos ZIP.
COTACOES_REUSE_RAW_BEFORE_REQUEST=false

# =============================================================================
# Complemento PROHORT
# =============================================================================

# Quando true, executa o complemento PROHORT uma vez depois de qualquer fluxo
# que salva no SQLite. A URL fica versionada em config/prohort.json.
COTACOES_COMPLEMENT_PROHORT=false

# =============================================================================
# Workflow de pacote e backup
# =============================================================================

# Estas variaveis sao usadas pelo GitHub Actions no environment `Crawler`.
# No uso local comum, nao precisam ser preenchidas no .env.

# Tag da release fixa usada como fallback enxuto.
DATA_RELEASE_TAG=latest-data

# Pacote enxuto publicado no GitHub Release, sem SQLite.
DATA_ASSET_NAME=ceasa-data-latest.tar.gz

# Ativa o backup completo no OneDrive pelo rclone.
# Se ficar false, ou se o secret RCLONE_CONFIG nao existir no GitHub Actions,
# a coleta continua pelo fluxo GitHub Release sem tentar OneDrive.
DATA_ONEDRIVE_BACKUP_ENABLED=false

# Pacote completo salvo no OneDrive, com SQLite.
DATA_ONEDRIVE_ASSET_NAME=ceasa-data-full-latest.tar.gz

# Nome do remote configurado no rclone.
DATA_ONEDRIVE_REMOTE=onedrive

# Diretorio base dentro do OneDrive.
DATA_ONEDRIVE_DIR=cotacoes-ceasa

# O conteudo multi-linha do rclone.conf deve ser salvo no GitHub como secret
# `RCLONE_CONFIG`, nao no .env local versionado.
