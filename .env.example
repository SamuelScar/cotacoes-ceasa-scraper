COTACOES_SOURCE=ceasa-pe
COTACOES_SOURCES_FILE=config/fontes.json
COTACOES_RAW_DIR=data/raw
COTACOES_DATABASE_PATH=data/cotacoes.sqlite
COTACOES_HTTP_TIMEOUT_SECONDS=30
COTACOES_REQUEST_DELAY_SECONDS=2.0
COTACOES_REUSE_RAW_BEFORE_REQUEST=false
COTACOES_PROHORT_URL=https://portaldeinformacoes.conab.gov.br/downloads/arquivos/ProhortDiario.txt

# Vazio busca a ultima cotacao disponivel. Tambem aceita DD/MM/YYYY ou YYYY-MM-DD.
COTACOES_TARGET_DATE=

# Quantidade de datas de cotacao anteriores a partir da data limite.
# Exemplo: 30 = data limite + 30 datas de cotacao anteriores encontradas.
COTACOES_QUOTES_BACK=0
